<!DOCTYPE html>
<html lang="fi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Valokuvaus - XXMXLI</title>
    <link rel="stylesheet" href="styles.css">
    <style>
        :root {
            --background: #0a0a0a;
            --surface: #1a1a1a;
            --accent: #00ffff;
            --text-primary: #ffffff;
            --text-secondary: #cccccc;
            --border: #333333;
            --glow: 0 0 10px var(--accent);
        }

        body {
            margin: 0;
            font-family: 'Arial', sans-serif;
            background: var(--background);
            color: var(--text-primary);
            min-height: 100vh;
        }

        .header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
            background: rgba(10, 10, 10, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--accent);
            padding: 1rem 0;
        }

        .nav-container {
            max-width: 1400px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 2rem;
        }

        .logo {
            font-size: 1.5rem;
            font-weight: bold;
            color: var(--accent);
            text-decoration: none;
            text-shadow: var(--glow);
        }

        .nav-menu {
            display: flex;
            list-style: none;
            margin: 0;
            padding: 0;
            gap: 2rem;
        }

        .nav-link {
            color: var(--text-secondary);
            text-decoration: none;
            padding: 0.5rem 1rem;
            border: 1px solid transparent;
            border-radius: 4px;
            transition: all 0.3s;
        }

        .nav-link:hover,
        .nav-link.active {
            border-color: var(--accent);
            box-shadow: var(--glow);
            color: var(--accent);
        }

        .main-container {
            margin-top: 80px;
            padding: 2rem;
            max-width: 1400px;
            margin: 80px auto 0;
        }

        .gallery-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
            padding: 20px;
        }

        .gallery-item {
            position: relative;
            aspect-ratio: 1;
            overflow: hidden;
            border: 1px solid var(--accent);
            border-radius: 8px;
            box-shadow: var(--glow);
            transition: all 0.3s;
            cursor: pointer;
        }

        .gallery-item:hover {
            transform: scale(1.02);
            box-shadow: 0 0 20px var(--accent);
        }

        .gallery-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s;
        }

        .gallery-item:hover img {
            transform: scale(1.1);
        }

        /* Modal Styles */
        .photo-modal {
            display: none;
            position: fixed;
            z-index: 9999;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.9);
            backdrop-filter: blur(10px);
            justify-content: center;
            align-items: center;
            padding: 20px;
            box-sizing: border-box;
        }

        .photo-modal.active {
            display: flex;
        }

        .modal-content-wrapper {
            position: relative;
            max-width: 90vw;
            max-height: 90vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .modal-image {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            border-radius: 8px;
            box-shadow: 0 0 30px rgba(0, 255, 255, 0.3);
            border: 2px solid var(--accent);
        }

        .close-button {
            position: absolute;
            top: -15px;
            right: -15px;
            width: 40px;
            height: 40px;
            background: var(--accent);
            color: var(--background);
            border: none;
            border-radius: 50%;
            font-size: 20px;
            font-weight: bold;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
            box-shadow: var(--glow);
        }

        .close-button:hover {
            background: #ffffff;
            color: var(--background);
            transform: scale(1.1);
            box-shadow: 0 0 15px var(--accent);
        }

        @media (max-width: 768px) {
            .gallery-container {
                grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
                gap: 15px;
                padding: 15px;
            }

            .main-container {
                padding: 1rem;
            }

            .nav-container {
                padding: 0 1rem;
            }

            .nav-menu {
                gap: 1rem;
            }
        }
    </style>
</head>
<body>
    <header class="header">
        <div class="nav-container">
            <a href="/" class="logo">XXMXLI</a>
            <nav>
                <ul class="nav-menu">
                    <li><a href="/" class="nav-link">Etusivu</a></li>
                    <li><a href="/photography.html" class="nav-link active">Valokuvaus</a></li>
                    <li><a href="/music.html" class="nav-link">Musiikki</a></li>
                    <li><a href="/videos.html" class="nav-link">Videot</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main class="main-container">
        <div class="gallery-container" id="photoGallery">
            <!-- Photos will be loaded here -->
        </div>
    </main>

    <!-- Photo Modal -->
    <div id="photoModal" class="photo-modal">
        <div class="modal-content-wrapper">
            <img id="modalImage" class="modal-image" src="" alt="">
            <button id="closeModal" class="close-button">&times;</button>
        </div>
    </div>

    <script>
        // Sample photos - replace with your actual photo data
        const photos = [
            { src: 'assets/images/photo1.jpg', alt: 'Photo 1' },
            { src: 'assets/images/photo2.jpg', alt: 'Photo 2' },
            { src: 'assets/images/photo3.jpg', alt: 'Photo 3' },
            // Add more photos as needed
        ];

        // Load photos into gallery
        function loadPhotos() {
            const gallery = document.getElementById('photoGallery');
            
            photos.forEach(photo => {
                const galleryItem = document.createElement('div');
                galleryItem.className = 'gallery-item';
                
                const img = document.createElement('img');
                img.src = photo.src;
                img.alt = photo.alt;
                img.loading = 'lazy';
                
                galleryItem.appendChild(img);
                gallery.appendChild(galleryItem);
                
                // Add click event to open modal
                galleryItem.addEventListener('click', () => openModal(photo.src, photo.alt));
            });
        }

        // Modal functionality
        const modal = document.getElementById('photoModal');
        const modalImage = document.getElementById('modalImage');
        const closeButton = document.getElementById('closeModal');

        function openModal(src, alt) {
            modalImage.src = src;
            modalImage.alt = alt;
            modal.classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeModal() {
            modal.classList.remove('active');
            document.body.style.overflow = '';
        }

        // Event listeners
        closeButton.addEventListener('click', closeModal);

        modal.addEventListener('click', (e) => {
            if (e.target === modal) {
                closeModal();
            }
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && modal.classList.contains('active')) {
                closeModal();
            }
        });

        // Initialize gallery
        document.addEventListener('DOMContentLoaded', loadPhotos);
    </script>
</body>
</html>