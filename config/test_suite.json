{
  "parallel_tests": 4,
  "timeout_seconds": 300,
  "performance_baseline_ms": 100,
  "security_scan_enabled": true,
  "test_categories": {
    "unit": {
      "enabled": true,
      "timeout": 60,
      "strict_mode": false
    },
    "integration": {
      "enabled": true,
      "timeout": 120,
      "dependency_check": true
    },
    "performance": {
      "enabled": true,
      "baseline_ms": 100,
      "benchmark_iterations": 3,
      "search_tools": ["rg", "ag", "awk", "grep"]
    },
    "security": {
      "enabled": true,
      "scan_depth": "comprehensive",
      "check_credentials": true,
      "check_injection": true,
      "check_permissions": true
    },
    "error_handling": {
      "enabled": true,
      "test_missing_deps": true,
      "test_corrupt_config": true,
      "test_disk_space": true
    }
  },
  "reporting": {
    "html_enabled": true,
    "text_enabled": true,
    "json_enabled": true,
    "include_logs": true,
    "include_metrics": true
  },
  "optimization_targets": {
    "search_tools": {
      "preferred_order": ["rg", "ag", "awk", "grep"],
      "fallback_enabled": true,
      "timeout_protection": true
    },
    "error_handling": {
      "graceful_degradation": true,
      "user_friendly_messages": true,
      "audit_logging": true
    },
    "performance": {
      "startup_time_ms": 1000,
      "search_time_ms": 100,
      "memory_efficient": true
    }
  }
}